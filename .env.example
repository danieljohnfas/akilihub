# ─────────────────────────────────────────────────────────────────────────────
# AkiliBrain environment variables. Copy to .env (Docker/Linode) or .env.local (dev).
# NEVER commit real values. `.env*` is gitignored.
# Required = the app misbehaves or refuses to start without it in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
DATABASE_URL=            # Supabase pooler URL (port 6543)
DIRECT_URL=              # Supabase direct URL (used by drizzle-kit / migrations)
NEXT_PUBLIC_APP_URL=https://akilibrain.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only; used for "Delete account" (never expose to the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Admin area (required in production) ──────────────────────────────────────
ADMIN_SESSION_SECRET=        # ≥32 random chars; signs admin JWTs. Login throws without it.
ADMIN_TOTP_ENCRYPTION_KEY=   # optional but recommended: encrypts the TOTP secret at rest (independent of session rotation)
ADMIN_SETUP_TOKEN=           # one-time token needed to run /admin/setup; unset it after setup (setup is disabled in prod when unset)
ADMIN_SECRET=                # optional: static header secret for scripts calling /api/salaries/verify
ADMIN_REPORT_EMAIL=          # recipient of cleanup/status emails
ADMIN_EMAIL=                 # recipient of tender alert emails

# ── Automation secrets (send as `Authorization: Bearer <secret>`) ────────────
CRON_SECRET=                 # /api/admin/send-report
SCRAPE_TRIGGER_SECRET=       # /api/trigger-scrape
CLEANUP_TRIGGER_SECRET=      # /api/admin/start-cleanup
EMAIL_TOKEN_SECRET=          # signs newsletter confirmation links (falls back to ADMIN_SESSION_SECRET)

# ── Background jobs ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SCRAPE_DISABLED=false        # kill switch: true stops EVERY AI-spending job
SCRAPE_JOB_TARGET=200
SCRAPE_JOB_SECOND_PASS=1

# ── Scraper sidecar (Python, Render) ─────────────────────────────────────────
SCRAPLING_URL=               # e.g. https://akilihub-scraper.onrender.com
SIDECAR_API_KEY=             # REQUIRED: same value on the sidecar (Render) and here. Sidecar refuses requests without it.
SERPER_API_KEY=
EXA_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
FIRECRAWL_API_KEY=
TYPESAFE_API_KEY=

# ── AI providers (each optional; numbered variants NAME_2, NAME_3… add more keys) ──
# Only providers with a key are enabled. There are no keyless/anonymous providers.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HYPERBOLIC_API_KEY=
NVIDIA_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
NOVITA_API_KEY=
AI21_API_KEY=
LEPTON_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Email / messaging ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TARGET_PHONE=

# ── Rate limiting (recommended; falls back to a per-instance in-memory limiter) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoring / analytics (optional; non-essential ones load only after user consent) ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_ADSENSE_PUB_ID=

# ── Build/CI switches ────────────────────────────────────────────────────────
# CSP_ENFORCE=1             # switch the CSP from report-only to enforcing (after reviewing [csp-report] logs)
# NEXT_OUTPUT=standalone     # set by the Dockerfile
# SKIP_TYPECHECK=1           # set by the Dockerfile (CI runs `npm run typecheck`)
# E2E_BASE_URL=http://localhost:3000
